# Environment Variables — NZ Travel Blog AI Engine
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# -----------------------------------------------
# Cloudinary (image hosting)
# OPTION 1 (recommended): Copy the full URL from Cloudinary Dashboard → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# -----------------------------------------------
CLOUDINARY_URL=cloudinary://591616998429991:lE18ju6D8jOa6QpdCKiM4iwYSWY@YOUR_CLOUD_NAME

# OPTION 2: Individual fields (alternative to CLOUDINARY_URL)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=591616998429991
# CLOUDINARY_API_SECRET=lE18ju6D8jOa6QpdCKiM4iwYSWY

# -----------------------------------------------
# ComfyUI (local image generation server)
# Default: http://localhost:8188
# Change only if you run ComfyUI on a different port
# -----------------------------------------------
COMFYUI_HOST=http://localhost:8188

# -----------------------------------------------
# Website Base URL (Production website)
# Note: In-article links MUST ALWAYS be relative (/blog/[slug]/)
# -----------------------------------------------
SITE_URL=https://nz-travel-hub.com

# -----------------------------------------------
# Notion (already configured via MCP — optional override)
# -----------------------------------------------
# NOTION_API_KEY=your_notion_api_key

